<mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" display="block" id="M19">
<mml:mo>[</mml:mo><mml:mrow><mml:msup><mml:mi> </mml:mi><mml:mrow><mml:mi>L</mml:mi></mml:mrow></mml:msup><mml:mrow><mml:msubsup><mml:mrow><mml:mi>D</mml:mi></mml:mrow><mml:mrow><mml:msup><mml:mrow><mml:mn>0</mml:mn></mml:mrow><mml:mrow><mml:mo>+</mml:mo></mml:mrow></mml:msup></mml:mrow><mml:mrow><mml:mi>θ</mml:mi></mml:mrow></mml:msubsup></mml:mrow><mml:msup><mml:mrow><mml:mi>s</mml:mi></mml:mrow><mml:mrow><mml:mi>θ</mml:mi><mml:mo>−</mml:mo><mml:mi>ϐ</mml:mi></mml:mrow></mml:msup></mml:mrow><mml:mo>]</mml:mo><mml:mo>(</mml:mo><mml:mrow><mml:mi>ƻ</mml:mi></mml:mrow><mml:mo>)</mml:mo><mml:mo>=</mml:mo><mml:mn>0</mml:mn><mml:mo>,</mml:mo><mml:mi>ϐ</mml:mi><mml:mo>=</mml:mo><mml:mn>1,2</mml:mn><mml:mo>,</mml:mo><mml:mo>⋯</mml:mo><mml:mo>,</mml:mo><mml:mo>[</mml:mo><mml:mrow><mml:mi>θ</mml:mi></mml:mrow><mml:mo>]</mml:mo><mml:mo>+</mml:mo><mml:mn>1</mml:mn><mml:mo>.</mml:mo>
</mml:math>
